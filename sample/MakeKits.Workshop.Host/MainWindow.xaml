<vio:ShellWindow x:Class="MakeKits.Workshop.Host.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:MakeKits.Workshop.Host"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
                 Title="MakeKits Workshop"
                 Width="1280"
                 Height="720"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/Resources/Logo.ico"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">

    <vio:ShellWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </vio:ShellWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <vio:TitleBar x:Name="AppTitleBar"
                      Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                      Grid.Row="0"
                      BackButtonClick="OnTitleBarBackClick"
                      BackButtonVisibility="Collapsed"
                      Icon="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                      IsBackButtonEnabled="False"
                      IsIconVisible="True"
                      IsInactiveAppearanceEnabled="True"
                      IsTitleVisible="True"
                      PaneToggleButtonVisibility="Collapsed">
            <vio:TitleBar.CustomFooter>
                <TextBlock Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding WorkshopCountText}"
                           WindowChrome.IsHitTestVisibleInChrome="True" />
            </vio:TitleBar.CustomFooter>
        </vio:TitleBar>

        <Grid Grid.Row="1">

            <!--
                ═══════════════════════════════════════════════
                Page 1 — Workshop card list
                ═══════════════════════════════════════════════
            -->
            <Grid x:Name="ListPage" Visibility="Visible">
                <vio:FluentScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ItemsControl Margin="16,12,16,16" ItemsSource="{Binding Workshops}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:WorkshopItemViewModel}">
                                    <Grid Margin="8">
                                        <ui:CardAction Width="300"
                                                       Height="150"
                                                       Padding="14,12"
                                                       VerticalContentAlignment="Stretch"
                                                       Command="{Binding OpenCommand}"
                                                       IsChevronVisible="False">
                                            <ui:CardAction.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <ui:MenuItem Command="{Binding OpenInNewWindowCommand}"
                                                                 Header="Open in New Window"
                                                                 Icon="{vio:FontIcon Glyph={x:Static ui:FontSymbols.OpenInNewWindow},
                                                                                     FontFamily={StaticResource SymbolThemeFontFamily}}" />
                                                </ContextMenu>
                                            </ui:CardAction.ContextMenu>
                                            <ui:Grid Height="126" RowDefinitions="Auto,*">
                                                <ui:Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                                                    <Border Grid.Column="0"
                                                            Width="42"
                                                            Height="42"
                                                            Margin="0,0,12,0"
                                                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                                            BorderThickness="1"
                                                            ClipToBounds="True"
                                                            CornerRadius="6">
                                                        <vio:Gravatar Width="42"
                                                                      Height="42"
                                                                      Id="{Binding Author}" />
                                                    </Border>

                                                    <ui:StackPanel Grid.Column="1"
                                                                   VerticalAlignment="Center"
                                                                   Spacing="3">
                                                        <TextBlock FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}" />
                                                        <ui:StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Text="{Binding Author}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Text="{Binding Version}" />
                                                        </ui:StackPanel>
                                                    </ui:StackPanel>
                                                </ui:Grid>

                                                <TextBlock Grid.Row="1"
                                                           Margin="0,10,0,0"
                                                           VerticalAlignment="Top"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding Description}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap"
                                                           ToolTip="{Binding Description}" />
                                            </ui:Grid>
                                        </ui:CardAction>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="36"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="📦" />
                            <TextBlock Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="No Workshop available" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Please place the plugin DLL into the workshops directory and restart the application." />
                        </StackPanel>
                    </Grid>
                </vio:FluentScrollViewer>
            </Grid>

            <!--
                ═══════════════════════════════════════════════
                Page 2 — Workshop view
                ═══════════════════════════════════════════════
            -->
            <Grid x:Name="WorkshopPage" Visibility="Collapsed">
                <ContentControl x:Name="WorkshopContentControl" />
            </Grid>

        </Grid>
    </Grid>
</vio:ShellWindow>
